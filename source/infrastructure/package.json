{
  "name": "@amzn/aws-waf-security-automations",
  "version": "4.2.0",
  "bin": {
    "infrastructure": "bin/aws-waf-security-automations.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --coverage",
    "test-update": "TEMPLATE_OUTPUT_BUCKET='solutions-reference' DIST_OUTPUT_BUCKET='solutions' SOLUTION_NAME='security-automations-for-aws-waf' VERSION='v4.2.0' AWS_REGION='us-west-2' cdk synth --version-reporting=false --asset-metadata=false --path-metadata=false && cat ./cdk.out/AwsWafSecurityAutomations.template.json > ./test/test_data/aws-waf-security-automations.template && cat ./cdk.out/AwsWafSecurityAutomationsFirehoseAthenaStack5CCC2486.nested.template.json > ./test/test_data/aws-waf-security-automations-firehose-athena.template && cat ./cdk.out/AwsWafSecurityAutomationsWebacl82D3803D.nested.template.json > ./test/test_data/aws-waf-security-automations-webacl.template",
    "pretest": "yarn clean && yarn install",
    "cdk": "cdk",
    "clean": "rm -rf node_modules",
    "lint": "npx eslint 'lib/**'",
    "prettier": "npx prettier --check 'lib/**/*.ts'",
    "prettierFix": "npx prettier --write 'lib/**/*.ts'",
    "deploy-us-west-2-security-automations-for-aws-waf-tst": "cdk deploy ops-waf-net-uw2-tst-waf --parameters AppAccessLogBucket=ops-proxy-net-uw2-tst-far-albaccesslogginge1d340e2-wbn79wt3otou --parameters ActionForHttpFloodProtectionParam=count --parameters ActionForBadBotProtectionParam=count --parameters ActionForReputationListsProtectionParam=count --parameters ActionForSqlInjectionProtectionParam=count --parameters ActionForCrossSiteScriptingProtectionParam=count --parameters ActionForScannersProbesProtectionParam=count",
    "diff-us-west-2-security-automations-for-aws-waf-tst": "cdk diff ops-waf-net-uw2-tst-waf --previous-parameters",
    "deploy-us-west-2-security-automations-for-aws-waf-prd": "cdk deploy ops-waf-net-uw2-prd-waf --parameters AppAccessLogBucket=ops-proxy-net-uw2-prd-far-albaccesslogginge1d340e2-b7gookhbt5gp --parameters ActionForHttpFloodProtectionParam=count --parameters ActionForBadBotProtectionParam=count --parameters ActionForReputationListsProtectionParam=count --parameters ActionForSqlInjectionProtectionParam=count --parameters ActionForCrossSiteScriptingProtectionParam=count --parameters ActionForScannersProbesProtectionParam=count",
    "diff-us-west-2-security-automations-for-aws-waf-prd": "cdk diff ops-waf-net-uw2-prd-waf --previous-parameters"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "aws-cdk": "2.1117.0",
    "cdk-constants": "3.0.3",
    "eslint": "^8.57.1",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "jiti": "^2.6.1",
    "prettier": "3.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.248.0",
    "constructs": "^10.4.2",
    "@kuali/kuali-cdk": "3.22.0"
  },
  "overrides": {
    "minimatch@3.x": "3.1.5"
  },
  "private": true,
  "license": "Apache-2.0",
  "description": "Security Automations for AWS WAF",
  "author": {
    "name": "Amazon Web Services",
    "url": "https://aws.amazon.com/solutions"
  },
  "jestSonar": {
    "reportPath": "coverage"
  }
}
